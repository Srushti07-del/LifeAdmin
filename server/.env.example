# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB (REQUIRED - persistent database connection)
# Local MongoDB: mongodb://localhost:27017/lifeadmin
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lifeadmin?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# JWT (REQUIRED - secret for signing user auth tokens)
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Gemini AI (Optional - for AI assistant and document extraction)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Public Web Application URL (used for CORS and password reset email generation)
# In development: http://localhost:5173
# In production: https://yourdomain.com (REQUIRED in production - must be HTTPS)
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# SMTP Email Configuration (REQUIRED for password reset emails)
# Compatible with Brevo (Sendinblue), SendGrid, Mailgun, AWS SES, Gmail, or custom SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login-or-email
SMTP_PASS=your-smtp-key-or-password
SMTP_FROM=noreply@yourdomain.com
# Optional: set to true if using direct SSL on port 465 (defaults to true for 465, false for 587)
# SMTP_SECURE=false
