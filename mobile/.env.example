# LifeAdmin Mobile API Configuration
#
# Connect to the existing LifeAdmin backend (Express server on port 5000)
#
# 1. Android Emulator:
#    Use http://10.0.2.2:5000/api (10.0.2.2 maps to host localhost)
#
# 2. Physical Android Device (same Wi-Fi network):
#    Use your computer's local IP address, e.g. http://192.168.1.100:5000/api
#
# 3. iOS Simulator / Web:
#    Use http://localhost:5000/api
#
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Optional: Request timeout in milliseconds (default: 10000)
EXPO_PUBLIC_API_TIMEOUT_MS=10000
